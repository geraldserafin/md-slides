{
  "name": "slideit",
  "version": "0.1.0",
  "description": "Presentations with code transitions animated by an AST diff (GumTree), written in a small tag markup.",
  "license": "BSD-3-Clause",
  "type": "module",
  "bin": {
    "slides": "cli/slideit.mjs",
    "slideit": "cli/slideit.mjs"
  },
  "files": [
    "cli",
    "lib",
    "src/tags.json",
    "viewer",
    "docs/llms.txt"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "slideit": "node cli/slideit.mjs",
    "dev": "node cli/slideit.mjs dev examples",
    "build": "tsc --noEmit && node cli/slideit.mjs build examples -o dist",
    "typecheck": "tsc --noEmit",
    "llms": "node scripts/llms.mjs dist",
    "test": "vitest run",
    "build:viewer": "node scripts/build-viewer.mjs",
    "prepublishOnly": "npm test && npm run build:package",
    "build:package": "node scripts/build-lib.mjs && node scripts/build-viewer.mjs"
  },
  "dependencies": {
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^25.14.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-tree-sitter": "^0.22.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geraldserafin/md-slides.git"
  },
  "homepage": "https://geraldserafin.github.io/md-slides/",
  "keywords": [
    "slides",
    "presentation",
    "code",
    "animation",
    "diff",
    "tree-sitter",
    "gumtree"
  ]
}
