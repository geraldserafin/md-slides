{
  "name": "slideit",
  "version": "0.1.0",
  "description": "Markdown presentations with code transitions animated by an AST diff (GumTree).",
  "license": "BSD-3-Clause",
  "type": "module",
  "private": true,
  "bin": {
    "slides": "cli/slideit.mjs",
    "slideit": "cli/slideit.mjs"
  },
  "files": [
    "cli",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "slideit": "node cli/slideit.mjs",
    "dev": "node cli/slideit.mjs dev examples",
    "build": "tsc --noEmit && node cli/slideit.mjs build examples -o dist",
    "typecheck": "tsc --noEmit",
    "llms": "node scripts/llms.mjs dist",
    "test": "vitest run"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^25.14.0",
    "tree-sitter-wasms": "^0.1.13",
    "vite": "^8.3.4",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
