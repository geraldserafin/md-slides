{
  "name": "slides-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": { "slides": "cli/slides.mjs" },
  "scripts": {
    "slides": "node cli/slides.mjs",
    "prepare-decks": "node scripts/prepare-decks.mjs",
    "dev": "npm run prepare-decks && vite",
    "build": "npm run prepare-decks && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "postject": "^1.0.0-alpha.6",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
