    },
    "string1": {
      "begin": "(#+)\"",
      "end": "\"\\1",
      "name": "string.quoted.double.raw.slides"
    },
    "string2": {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.slides",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#inline"
        }
      ]
    },
    "string3": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.slides",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#inline"
        }
      ]
    }
