      "patterns": [
        {
          "match": "\\*\\*[^*\\n]+\\*\\*",
          "name": "markup.bold.slides"
        },
        {
          "match": "(?<![*\\w])\\*[^*\\s][^*\\n]*\\*(?![*\\w])",
