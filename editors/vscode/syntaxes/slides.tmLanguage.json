        {
          "include": "#comment"
        },
        {
          "include": "#string0"
        },
        {
          "include": "#string1"
        },
        {
          "include": "#string2"
        },
        {
          "include": "#string3"
        },
        {
          "match": "#(?:true|false|null|inf|-inf|nan)\\b",
          "name": "constant.language.slides"
        },
        {
          "match": "(?<![\\w-])-?\\d[\\d_]*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?(?![\\w-])",
          "name": "constant.numeric.slides"
        },
        {
          "match": "([\\w.-]+)(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.slides"
            },
            "2": {
              "name": "punctuation.separator.key-value.slides"
            }
          }
        },
        {
          "match": "/-",
          "name": "keyword.operator.slashdash.slides"
        },
        {
          "match": "(?:^|(?<=[{};]))\\s*(?:(/-)\\s*)?(-|[A-Za-z_][\\w.-]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.slashdash.slides"
            },
            "2": {
              "name": "entity.name.tag.slides"
            }
          }
        },
        {
          "match": "[\\w.-]+",
          "name": "variable.parameter.flag.slides"
        }
      ]
    },
    "props": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string0"
        },
        {
          "include": "#string1"
        },
        {
          "include": "#string2"
        },
        {
          "include": "#string3"
        },
        {
          "match": "#(?:true|false|null|inf|-inf|nan)\\b",
          "name": "constant.language.slides"
        },
        {
          "match": "(?<![\\w-])-?\\d[\\d_]*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?(?![\\w-])",
          "name": "constant.numeric.slides"
        },
        {
          "match": "([\\w.-]+)(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.slides"
            },
            "2": {
              "name": "punctuation.separator.key-value.slides"
            }
          }
        },
        {
          "match": "/-",
          "name": "keyword.operator.slashdash.slides"
        },
        {
          "match": "(?:^|(?<=[{};]))\\s*(?:(/-)\\s*)?(-|[A-Za-z_][\\w.-]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.slashdash.slides"
            },
            "2": {
              "name": "entity.name.tag.slides"
            }
          }
        },
        {
          "match": "[\\w.-]+",
          "name": "variable.parameter.flag.slides"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.slides"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.slides"
        }
      ]
    },
    "escape": {
      "match": "\\\\(?:[nrt\\\\\"/bf]|u\\{[0-9a-fA-F]{1,6}\\}|\\s)",
      "name": "constant.character.escape.slides"
    },
    "inline": {
      "patterns": [
        {
          "match": "\\*\\*[^*\\n]+\\*\\*",
          "name": "markup.bold.slides"
        },
        {
          "match": "(?<![*\\w])\\*[^*\\s][^*\\n]*\\*(?![*\\w])",
          "name": "markup.italic.slides"
        },
        {
          "match": "`[^`\\n]+`",
          "name": "markup.inline.raw.slides"
        },
        {
          "match": "~~[^~\\n]+~~",
          "name": "markup.strikethrough.slides"
        },
        {
          "match": "==[^=\\n]+==",
          "name": "markup.changed.slides"
        },
        {
          "match": "\\[[^\\]\\n]+\\]\\([^)\\n]+\\)",
          "name": "markup.underline.link.slides"
        }
      ]
    },
    "string0": {
      "begin": "(#+)\"\"\"",
      "end": "\"\"\"\\1",
      "name": "string.quoted.triple.raw.slides"
    },
    "string1": {
      "begin": "(#+)\"",
      "end": "\"\\1",
      "name": "string.quoted.double.raw.slides"
    },
    "string2": {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "string.quoted.triple.slides",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#inline"
        }
      ]
    },
    "string3": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.slides",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#inline"
        }
      ]
    }
  }
