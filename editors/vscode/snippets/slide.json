{
  "Slide settings": { "prefix": "slide", "description": "Settings of this slide", "body": ["<slide>", "\t${1:theme}: ${2:light}", "</slide>"] },
  "Cover slide": { "prefix": "cover", "description": "A title slide", "body": ["<slide>", "\tlayout: cover", "\thalign: center", "\tvalign: center", "</slide>", "", "<h1>${1:Title}</h1>", "<p>${2:Subtitle}</p>"] },
  "Heading 2": { "prefix": "h2", "body": "<h2>${1:Heading}</h2>" },
  "Paragraph": { "prefix": "p", "body": "<p>${1:Text}</p>" },
  "Bullet list": { "prefix": "ul", "body": ["<ul${1: steps}>", "\t<li>${2:one}</li>", "\t<li>${3:two}</li>", "</ul>"] },
  "Numbered list": { "prefix": "ol", "body": ["<ol>", "\t<li>${1:one}</li>", "\t<li>${2:two}</li>", "</ol>"] },
  "Table": { "prefix": "table", "body": ["<table>", "\t<tr><th>${1:A}</th><th>${2:B}</th></tr>", "\t<tr><td>${3:1}</td><td>${4:2}</td></tr>", "</table>"] },
  "Row": { "prefix": "row", "description": "Parts side by side", "body": ["<row>", "\t$0", "</row>"] },
  "Col": { "prefix": "col", "description": "Parts stacked", "body": ["<col>", "\t$0", "</col>"] },
  "Two columns": { "prefix": "cols", "description": "Text left, code right", "body": ["<row>", "\t<col>", "\t\t<h2>${1:Title}</h2>", "\t\t<p>${2:Text}</p>", "\t</col>", "\t<code lang=${3:ts}>", "\t\t<frame>", "\t\t\t${4:let a = 1;}", "\t\t</frame>", "\t\t<frame>", "\t\t\t${5:let a = 2;}", "\t\t</frame>", "\t</code>", "</row>"] },
  "Step": { "prefix": "step", "description": "Appears on the next click", "body": ["<step>", "\t$0", "</step>"] },
  "Section": { "prefix": "section", "description": "One of several parts of a slide", "body": ["<section>", "\t<h2>${1:Heading}</h2>", "\t$0", "</section>"] },
  "Code block": { "prefix": "code", "description": "Animated code with frames", "body": ["<code lang=${1:ts}>", "\t<frame>", "\t\t$2", "\t</frame>", "\t<frame>", "\t\t$3", "\t</frame>", "</code>"] },
  "Single code block": { "prefix": "code1", "body": ["<code lang=${1:ts}>", "\t$0", "</code>"] },
  "Frame": { "prefix": "frame", "body": ["<frame${1: focus=${2:1}}>", "\t$0", "</frame>"] },
  "Image": { "prefix": "img", "body": "<img src=${1:file.png} ${2:class=left }/>" },
  "Video": { "prefix": "video", "body": "<video src=${1:clip.webm} autoplay loop muted />" },
  "Chart": { "prefix": "chart", "body": ["<chart type=${1|bar,line,pie|} title=\"${2:Title}\">", "\t${3:label}, ${4:value}", "\t${5:a}, ${6:1}", "\t${7:b}, ${8:2}", "</chart>"] },
  "Diagram": { "prefix": "diagram", "body": ["<diagram>", "\tflowchart LR", "\t\t${1:A} --> ${2:B}", "</diagram>"] },
  "Math": { "prefix": "tex", "body": "<tex>${1:x^2}</tex>" },
  "Notes": { "prefix": "notes", "body": ["<notes>", "\t$0", "</notes>"] },
  "Inline code": { "prefix": "c", "body": "<c>${1:code}</c>" }
}
