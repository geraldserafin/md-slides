{
  "Slide": {
    "prefix": "slide",
    "description": "A slide",
    "body": [
      "slide {",
      "\ttitle \"${1:Title}\"",
      "\t$0",
      "}"
    ]
  },
  "Cover slide": {
    "prefix": "cover",
    "description": "A title slide",
    "body": [
      "slide layout=cover {",
      "\ttitle \"${1:Title}\"",
      "\ttext \"${2:Subtitle}\"",
      "}"
    ]
  },
  "Deck": {
    "prefix": "deck",
    "description": "The settings of the deck",
    "body": [
      "deck title=\"${1:Title}\" author=\"${2:Me}\" theme=${3|dark,light,paper|}"
    ]
  },
  "Title": {
    "prefix": "title",
    "body": "title \"${1:Title}\""
  },
  "Heading": {
    "prefix": "heading",
    "body": "heading \"${1:Heading}\""
  },
  "Text": {
    "prefix": "text",
    "body": "text \"${1:Text}\""
  },
  "Bullet list": {
    "prefix": "list",
    "body": [
      "list${1: steps} {",
      "\t- \"${2:one}\"",
      "\t- \"${3:two}\"",
      "}"
    ]
  },
  "Numbered list": {
    "prefix": "listn",
    "body": [
      "list numbered {",
      "\t- \"${1:one}\"",
      "\t- \"${2:two}\"",
      "}"
    ]
  },
  "Quote": {
    "prefix": "quote",
    "body": "quote \"${1:Text}\" by=\"${2:Who}\""
  },
  "Table": {
    "prefix": "table",
    "body": [
      "table {",
      "\thead \"${1:A}\" \"${2:B}\"",
      "\t- \"${3:1}\" \"${4:2}\"",
      "}"
    ]
  },
  "Row": {
    "prefix": "row",
    "description": "Parts side by side",
    "body": [
      "row {",
      "\t$0",
      "}"
    ]
  },
  "Col": {
    "prefix": "col",
    "description": "Parts stacked",
    "body": [
      "col {",
      "\t$0",
      "}"
    ]
  },
  "Two columns": {
    "prefix": "two",
    "description": "A slide with two columns",
    "body": [
      "slide layout=two-cols {",
      "\ttitle \"${1:Title}\"",
      "\tleft {",
      "\t\ttext \"${2:Text}\"",
      "\t}",
      "\tright {",
      "\t\t$0",
      "\t}",
      "}"
    ]
  },
  "Text and code": {
    "prefix": "cols",
    "description": "Text left, animated code right",
    "body": [
      "slide {",
      "\ttitle \"${1:Title}\"",
      "\ttext \"${2:Text}\"",
      "\tswap {",
      "\t\tcode \"${3:ts}\" #\"\"\"",
      "\t\t\t${4:let a = 1;}",
      "\t\t\t\"\"\"#",
      "\t\tcode \"${3:ts}\" #\"\"\"",
      "\t\t\t${5:let a = 2;}",
      "\t\t\t\"\"\"#",
      "\t}",
      "}"
    ]
  },
  "Step": {
    "prefix": "step",
    "description": "Appears on the next click",
    "body": [
      "step {",
      "\t$0",
      "}"
    ]
  },
  "Pause": {
    "prefix": "pause",
    "body": "pause"
  },
  "Code block": {
    "prefix": "code",
    "body": [
      "code \"${1:ts}\" #\"\"\"",
      "\t$0",
      "\t\"\"\"#"
    ]
  },
  "Image": {
    "prefix": "image",
    "body": "image \"${1:file.png}\" alt=\"${2:}\""
  },
  "Video": {
    "prefix": "video",
    "body": "video \"${1:clip.webm}\" autoplay loop muted"
  },
  "Chart": {
    "prefix": "chart",
    "body": [
      "chart \"${1|bar,line,pie|}\" title=\"${2:Title}\" #\"\"\"",
      "\t${3:label}, ${4:value}",
      "\t${5:a}, ${6:1}",
      "\t${7:b}, ${8:2}",
      "\t\"\"\"#"
    ]
  },
  "Diagram": {
    "prefix": "diagram",
    "body": [
      "diagram #\"\"\"",
      "\tflowchart LR",
      "\t\t${1:A} --> ${2:B}",
      "\t\"\"\"#"
    ]
  },
  "Math": {
    "prefix": "math",
    "body": "math #\"\"\" ${1:x^2} \"\"\"#"
  },
  "Notes": {
    "prefix": "notes",
    "body": [
      "notes #\"\"\"",
      "\t$0",
      "\t\"\"\"#"
    ]
  },
  "Own layout": {
    "prefix": "layout",
    "body": [
      "layout \"${1:name}\" {",
      "\trow {",
      "\t\tcol size=\"${2:30%}\" { slot \"${3:side}\" }",
      "\t\tcol { slot }",
      "\t}",
      "}"
    ]
  },
  "Animated code": {
    "prefix": "swapcode",
    "description": "Code that changes state by state",
    "body": [
      "swap {",
      "\tcode \"${1:ts}\" #\"\"\"",
      "\t\t${2:let a = 1;}",
      "\t\t\"\"\"#",
      "\tcode \"${1:ts}\"${3: focus=\"1\"} #\"\"\"",
      "\t\t${4:let a = 2;}",
      "\t\t\"\"\"#",
      "}"
    ]
  },
  "Swap": {
    "prefix": "swap",
    "description": "One child at a time, in one place",
    "body": [
      "swap${1: anim=left} {",
      "\tcol {",
      "\t\t$2",
      "\t}",
      "\tcol {",
      "\t\t$0",
      "\t}",
      "}"
    ]
  }
}
