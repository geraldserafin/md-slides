{
  "name": "slideit-vscode",
  "displayName": "slideit",
  "description": "Syntax highlighting, diagnostics, completion and a live preview for .slides presentations",
  "version": "0.3.0",
  "publisher": "serafingerald",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/geraldserafin/slideit.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:slides"
  ],
  "contributes": {
    "languages": [
      {
        "id": "slides",
        "aliases": [
          "Slides",
          "slides"
        ],
        "extensions": [
          ".slides"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "slides",
        "scopeName": "source.slides",
        "path": "./syntaxes/slides.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "slides.preview",
        "title": "Slides: Open preview to the side",
        "icon": "$(open-preview)"
      },
      {
        "command": "slides.stopPreview",
        "title": "Slides: Stop the preview server"
      },
      {
        "command": "slides.check",
        "title": "Slides: Check the deck"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "slides.preview",
          "when": "resourceLangId == slides",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "slides.preview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "resourceLangId == slides"
      }
    ],
    "configuration": {
      "title": "Slides",
      "properties": {
        "slides.server": {
          "type": "string",
          "enum": [
            "bundled",
            "cli"
          ],
          "default": "bundled",
          "description": "Where the language server (completion, hover, diagnostics) comes from: bundled with this extension, or `slides lsp` of the installed command."
        },
        "slides.command": {
          "type": "string",
          "default": "",
          "description": "The slides command used for the preview (and for the server when slides.server is \"cli\"). Empty: `slides` if it is on the PATH, else `npx @geraldserafin/slideit`."
        },
        "slides.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments put before the subcommand of slides.command."
        },
        "slides.previewFollowsCursor": {
          "type": "boolean",
          "default": true,
          "description": "The preview shows the slide the cursor is in."
        }
      }
    },
    "snippets": [
      {
        "language": "slides",
        "path": "./snippets/slides.json"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "@bgotink/kdl": "^0.4.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  },
  "scripts": {
    "grammar": "node build-grammar.mjs",
    "server": "node build-server.mjs",
    "vscode:prepublish": "npm run grammar && npm run server",
    "package": "vsce package"
  }
}
