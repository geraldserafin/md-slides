{
  "name": "tree-sitter-slide",
  "version": "0.1.0",
  "description": "tree-sitter grammar of the slideit markup (.slide files)",
  "license": "BSD-3-Clause",
  "main": "bindings/node",
  "keywords": ["tree-sitter", "parser", "slide"],
  "tree-sitter": [{ "scope": "text.slide", "file-types": ["slide"], "injection-regex": "slide", "highlights": "queries/highlights.scm", "injections": "queries/injections.scm" }],
  "devDependencies": { "tree-sitter-cli": "^0.25.0" }
}
