{
  "title": "Fernly: a seed pitch",
  "description": "A startup pitch: big statements, a flow diagram, charts, a table and the ask",
  "order": 5,
  "theme": "launch",
  "schemes": {
    "light": "launch-light",
    "dark": "launch"
  },
  "css": "deck.css",
  "themes": {
    "launch": {
      "--tok-keyword": "#e3a76f",
      "--tok-ident": "#e5e5e5",
      "--tok-property": "#86b4dc",
      "--tok-type": "#d6c28a",
      "--tok-builtin": "#c58fa8",
      "--tok-comment": "#6b6b6b",
      "--tok-punct": "#7a7a7a",
      "--tok-plain": "#c4c4c4",
      "--bg": "#14111f",
      "--fg": "#d9d4ea",
      "--heading": "#ffffff",
      "--muted": "#8b84a6",
      "--accent": "#ff7a59",
      "--code-bg": "#1f1a33"
    },
    "launch-light": {
      "--tok-keyword": "#a23b72",
      "--tok-ident": "#23262e",
      "--tok-property": "#2f6690",
      "--tok-type": "#8a6d1f",
      "--tok-builtin": "#b0572a",
      "--tok-comment": "#9a9ca5",
      "--tok-punct": "#8c8f99",
      "--tok-plain": "#3a3d46",
      "--bg": "#fff8f3",
      "--fg": "#3a3347",
      "--heading": "#1e1630",
      "--muted": "#857b99",
      "--accent": "#e5502d",
      "--code-bg": "#f6ece4"
    }
  },
