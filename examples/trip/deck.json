{
  "title": "Iceland in six pictures",
  "description": "A photo-story style deck with full-screen gradients, big type and slide transitions",
  "order": 9,
  "theme": "nordic",
  "schemes": {
    "dark": "nordic"
  },
  "css": "deck.css",
  "themes": {
    "nordic": {
      "--tok-keyword": "#e3a76f",
      "--tok-ident": "#e5e5e5",
      "--tok-property": "#86b4dc",
      "--tok-type": "#d6c28a",
      "--tok-builtin": "#c58fa8",
      "--tok-comment": "#6b6b6b",
      "--tok-punct": "#7a7a7a",
      "--tok-plain": "#c4c4c4",
      "--bg": "#0b1320",
      "--fg": "#d6e2f0",
      "--heading": "#ffffff",
      "--muted": "#8aa0bb",
      "--accent": "#7fd1ff",
      "--code-bg": "#101c2e"
    }
  },
  "animation": {
    "move": 0.5,
    "fade": 0.3,
    "textTransition": "fade"
  },
  "fonts": [
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    }
  ],
  "vars": {
    "--font-text": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "--font-heading": "\"Libertinus Serif\", Georgia, serif",
    "--text-size": "clamp(22px, 3.8vmin, 50px)",
    "--heading-size": "clamp(44px, 8vmin, 104px)"
  },
  "defaults": {
    "justify": "false",
    "padding": "9vmin 12vmin"
  }
}
