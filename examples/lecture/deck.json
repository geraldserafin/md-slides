{
  "title": "Waves: a first lecture",
  "description": "A physics lecture: math, a diagram, a chart and a quiz with reveals",
  "order": 7,
  "theme": "paper-lecture",
  "schemes": {
    "light": "paper-lecture",
    "dark": "chalk"
  },
  "css": "deck.css",
  "themes": {
    "paper-lecture": {
      "--tok-keyword": "#a23b72",
      "--tok-ident": "#23262e",
      "--tok-property": "#2f6690",
      "--tok-type": "#8a6d1f",
      "--tok-builtin": "#b0572a",
      "--tok-comment": "#9a9ca5",
      "--tok-punct": "#8c8f99",
      "--tok-plain": "#3a3d46",
      "--bg": "#f7f3ea",
      "--fg": "#3b352c",
      "--heading": "#1f1b14",
      "--muted": "#8a8170",
      "--accent": "#a04a1e",
      "--code-bg": "#ece5d4"
    },
    "chalk": {
      "--tok-keyword": "#e3a76f",
      "--tok-ident": "#e5e5e5",
      "--tok-property": "#86b4dc",
      "--tok-type": "#d6c28a",
      "--tok-builtin": "#c58fa8",
      "--tok-comment": "#6b6b6b",
      "--tok-punct": "#7a7a7a",
      "--tok-plain": "#c4c4c4",
      "--bg": "#1c2a27",
      "--fg": "#d7e3dc",
      "--heading": "#fffdf2",
      "--muted": "#8fa59b",
      "--accent": "#f4d35e",
      "--code-bg": "#16211f"
    }
  },
  "animation": {
    "move": 0.5,
    "fade": 0.3,
    "textTransition": "fade"
  },
  "footer": {
    "left": "Physics 101 · Waves",
    "right": "{slide} / {slides}",
    "height": 48
  },
  "fonts": [
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    }
  ],
  "vars": {
    "--font-text": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "--font-heading": "\"Libertinus Serif\", Georgia, serif"
  },
  "defaults": {
    "justify": "false",
    "padding": "9vmin 12vmin"
  }
}
