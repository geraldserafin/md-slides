<section>
  <row>
    <h2>Step 3: functional style</h2>
    <code lang=typescript id=calc>
      interface Item {
        price: number;
        qty: number;
      }

      const calculateTotal = (cartItems: Item[]): number => {
        if (cartItems.length === 0) {
          return 0;
        }

        let total = 0;
        for (const item of cartItems) {
          total += item.price * item.qty;
        }
        return total;
      };
    </code>
  </row>
</section>

<section>
  <row>
    <h2>Step 4: Extract Method</h2>
    <code lang=typescript id=calc>
      <frame>
        interface Item {
          price: number;
          qty: number;
        }

        function itemTotal(item: Item): number {
          return item.price * item.qty;
        }

        const calculateTotal = (cartItems: Item[]): number => {
          if (cartItems.length === 0) {
            return 0;
          }

          let total = 0;
          for (const item of cartItems) {
            total += item.price * item.qty;
          }
          return total;
        };
      </frame>
      <frame>
        interface Item {
          price: number;
          qty: number;
        }

        function itemTotal(item: Item): number {
          return item.price * item.qty;
        }

        const calculateTotal = (cartItems: Item[]): number => {
          if (cartItems.length === 0) {
            return 0;
          }

          let total = 0;
          for (const item of cartItems) {
            total += itemTotal(item);
          }
          return total;
        };
      </frame>
    </code>
  </row>
</section>

<section>
  <row>
    <col>
      <h2>Step 5: .reduce and export</h2>
      <step at=1>
        <p>The end. Thanks!</p>
      </step>
    </col>
    <code lang=typescript id=calc>
      <frame>
        interface Item {
          price: number;
          qty: number;
        }

        function itemTotal(item: Item): number {
          return item.price * item.qty;
        }

        const calculateTotal = (cartItems: Item[]): number =>
          cartItems.reduce((total, item) => total + itemTotal(item), 0);
      </frame>
      <frame>
        interface Item {
          price: number;
          qty: number;
        }

        export function itemTotal(item: Item): number {
          return item.price * item.qty;
        }

        export const calculateTotal = (cartItems: Item[]): number =>
          cartItems.reduce((total, item) => total + itemTotal(item), 0);
      </frame>
    </code>
  </row>
</section>

<notes>
  function declaration -> const arrow function
</notes>

<notes>
  two steps: first add the new function (duplicated logic), then swap the call site
</notes>

<notes>
  split in two because otherwise the diff gets lost on identical structure
</notes>

