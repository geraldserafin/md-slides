{
  "title": "Refactoring: a cart total",
  "description": "TypeScript refactoring: types, naming, functional style",
  "order": 2,
  "theme": "midnight",
  "css": "deck.css",
  "themes": {
    "ink": {
      "--bg": "#fbfaf6",
      "--fg": "#2b2e36",
      "--heading": "#11131a",
      "--muted": "#7a7d87",
      "--accent": "#3a5ba0",
      "--tok-keyword": "#a23b72",
      "--tok-ident": "#23262e",
      "--tok-property": "#2f6690",
      "--tok-type": "#8a6d1f",
      "--tok-builtin": "#b0572a",
      "--tok-comment": "#9a9ca5",
      "--tok-punct": "#8c8f99",
      "--tok-plain": "#3a3d46",
      "--code-bg": "#f1eee6"
    },
    "midnight": {
      "--bg": "#1c1c1c",
      "--fg": "#d4d4d4",
      "--heading": "#fafafa",
      "--muted": "#8a8a8a",
      "--accent": "#e3b06a",
      "--tok-keyword": "#e3a76f",
      "--tok-ident": "#e5e5e5",
      "--tok-property": "#86b4dc",
      "--tok-type": "#d6c28a",
      "--tok-builtin": "#c58fa8",
      "--tok-comment": "#6b6b6b",
      "--tok-punct": "#7a7a7a",
      "--tok-plain": "#c4c4c4",
      "--code-bg": "#141414"
    }
  },
  "fonts": [
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    }
  ],
  "vars": {
    "--font-text": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "--font-heading": "\"Libertinus Serif\", Georgia, serif",
    "--text-size": "clamp(18px, 2.55vmin, 33px)",
    "--heading-size": "clamp(26px, 4.1vmin, 52px)"
  },
  "footer": {
    "left": "Refactoring: a cart total",
    "right": "{slide} / {slides}",
    "height": 48
  },
  "defaults": {
    "layout": "side",
    "justify": "true"
  },
  "columns": {
    "valign": "center"
  },
  "textOnly": {
    "halign": "center",
    "valign": "center"
  }
}
