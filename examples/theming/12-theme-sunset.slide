<slide>
  theme: sunset
</slide>

<h2>A custom theme: <c>sunset</c></h2>

<p>
  Defined once under <c>themes</c> in this deck's <c>deck.json</c> and used here with <c>theme: sunset</c>.
  It also joins the <b>t</b> key cycle.
</p>

<code lang=typescript id=g1 class=left>
  <frame>
    const theme = {
      name: "sunset",
      warm: true,
    };
  </frame>
  <frame>
    const theme = {
      name: "sunset",
      warm: true,
      accent: "#ff9e64",
    };
  </frame>
</code>
