<slide>
  --move-dur: 1.6s
  --fade-dur: 0.9s
</slide>

<h2>Slow motion</h2>

<p>
  Every animation knob is a CSS variable, so a slide can override it:
  <c>--move-dur: 1.6s</c> and <c>--fade-dur: 0.9s</c> in the <c><slide></c> block.
</p>

<code lang=typescript id=g1>
  <frame>
    function area(w: number, h: number) {
      const result = w * h;
      return result;
    }
  </frame>
  <frame>
    function area(h: number, w: number) {
      return h * w;
    }
  </frame>
  <frame>
    const area = (h: number, w: number) => h * w;
  </frame>
</code>

<notes>
  Perfect for a slide where the transition IS the point.
</notes>
