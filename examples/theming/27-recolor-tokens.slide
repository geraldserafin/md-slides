<slide>
  --tok-keyword: #ff5d8f
  --tok-ident: #ffe66d
  --tok-type: #4ecdc4
  --tok-builtin: #ff9f1c
  --tok-punct: #8d99ae
  --accent: #4ecdc4
</slide>

<h2>Recolor syntax per slide</h2>

<p>
  The <c><slide></c> block of this slide sets <c>--tok-keyword</c>, <c>--tok-ident</c>, <c>--tok-type</c>,
  <c>--tok-builtin</c> and <c>--tok-punct</c>. No theme needed.
</p>

<code lang=typescript id=g1>
  <frame>
    interface Point { x: number; y: number }

    function norm(p: Point): number {
      return Math.sqrt(p.x ** 2 + p.y ** 2);
    }
  </frame>
  <frame>
    interface Point { x: number; y: number }

    function norm({ x, y }: Point): number {
      return Math.hypot(x, y);
    }
  </frame>
</code>
