<slide>
  --move-dur: 0s
  --fade-dur: 0s
</slide>

<h2>Instant</h2>

<p>
  <c>--move-dur: 0s</c> and <c>--fade-dur: 0s</c>: frames switch with no animation at all.
  (Visitors who ask the OS for reduced motion get this automatically.)
</p>

<code lang=typescript id=g1>
  <frame>
    const mode = "instant";
  </frame>
  <frame>
    const mode = "instant";
    const delay = 0;
  </frame>
</code>
