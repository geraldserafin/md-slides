<row>
  <col size=34%>
    <h2>Column widths: <c>size</c></h2>

    <p>
      In a <c><row></c> every part takes an equal share of the width.
      <c>size=34%</c> makes this one narrower, here for a short note next to wider code. <c>size=2</c> would be a weight: twice as wide.
    </p>
  </col>
  <code lang=typescript>
    <frame>
      const columns = { text: "34%", code: "the rest" };
    </frame>
    <frame>
      const columns = { text: "34%", code: "the rest", gap: "4vmin" };
    </frame>
  </code>
</row>
