<section>
  <h2>A slide with three sections</h2>

  <p>
    This single slide has three sections. Each one is a heading plus code. Moving between sections
    fades the text, and the code morphs because all its blocks share the id <c>cart</c>.
  </p>
  <code lang=typescript id=cart>
    <frame>
      const cart = [];
    </frame>
    <frame>
      const cart = [];
      cart.push({ sku: "A1", qty: 2 });
    </frame>
  </code>
</section>

<section>
  <h2>Section two: more state</h2>

  <p>Same slide, new heading. The old text fades out, the new one fades in, the code keeps morphing.</p>
  <code lang=typescript>
    const cart: Item[] = [];
    cart.push({ sku: "A1", qty: 2 });
    cart.push({ sku: "B7", qty: 1 });
  </code>
</section>

<section>
  <h2>Section three: derive a value</h2>

  <p>The last section computes something from the state above.</p>
  <code lang=typescript id=cart>
    <frame>
      const cart: Item[] = [];
      cart.push({ sku: "A1", qty: 2 });
      cart.push({ sku: "B7", qty: 1 });

      const count = cart.reduce((n, item) => n + item.qty, 0);
    </frame>
    <frame>
      const cart: Item[] = [];
      cart.push({ sku: "A1", qty: 2 });
      cart.push({ sku: "B7", qty: 1 });

      const count = cart.reduce((n, item) => n + item.qty, 0);
      console.log(`${count} items`);
    </frame>
  </code>
</section>

<notes>
  This file is ONE slide but several steps. The progress counter stays at the same slide number.
</notes>
