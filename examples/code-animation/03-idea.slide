<h2>Code that moves</h2>

<p>
  Write the <i>before</i> and the <i>after</i> as two code blocks.
  <c>slides</c> parses both, matches the syntax trees and animates the difference:
  unchanged tokens stay, moved tokens glide, new ones fade in.
</p>

<code lang=typescript id=g1>
  <frame>
    function total(items: number[]) {
      let sum = 0;
      for (const x of items) {
        sum += x;
      }
      return sum;
    }
  </frame>
  <frame>
    function total(items: number[]) {
      const sum = items.reduce(
        (acc, x) => acc + x,
        0,
      );
      return sum;
    }
  </frame>
  <frame>
    const total = (items: number[]) =>
      items.reduce((acc, x) => acc + x, 0);
  </frame>
</code>

<notes>
  Press the right arrow slowly and watch `total`, `items` and `return` keep their identity.
</notes>
