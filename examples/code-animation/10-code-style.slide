<h2>Code style: panel, line numbers, title</h2>

<p>
  Per block: classes <c>.panel</c> (a background box), <c>.lines</c> (line numbers) and options <c>start=10</c>, <c>title="cart.ts"</c>,
  <c>bg=#16213e</c>, <c>radius=14</c>, <c>pad="1em 1.4em"</c>. Deck-wide defaults live under <c>code</c> in <c>deck.json</c>.
</p>

<code lang=typescript class="panel lines" title=cart.ts start=10>
  export function total(items: Item[]): number {
    let sum = 0;
    for (const item of items) sum += item.price;
    return sum;
  }
</code>

<code lang=typescript class=panel bg=#fff1cf title="no numbers, own color">
  const rate = 0.23;
</code>
