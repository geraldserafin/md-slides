slide layout=cover align=center valign=middle justify=#false {
  title "Code that moves"
  text "How the diff animates every edit."
  text "Rename, insert, delete, move, wrap, extract · press **→**"
  notes #"""
    Code animation: part of the slides manual. Source: examples/code-animation.
    """#
}

slide {
  heading "What's inside"
  list numbered {
    - "What the diff does, edit by edit"
    - "Code blocks, groups and frames"
    - "Languages"
    - "Style, focus lines and fit"
    - "How the matching works"
  }
  notes #"""
    Press o at any time for the slide drawer, h for help. Every slide in this deck is live: it uses the feature it describes.
    """#
}

slide layout="code-side" {
  heading "Code that moves"
  text "Write the *before* and the *after* as two code blocks. `slides` parses both, matches the syntax trees and animates the difference: unchanged tokens stay, moved tokens glide, new ones fade in."
  swap {
    code "typescript" id=g1 #"""
      function total(items: number[]) {
        let sum = 0;
        for (const x of items) {
          sum += x;
        }
        return sum;
      }
      """#
    code "typescript" #"""
      function total(items: number[]) {
        const sum = items.reduce(
          (acc, x) => acc + x,
          0,
        );
        return sum;
      }
      """#
    code "typescript" #"""
      const total = (items: number[]) =>
        items.reduce((acc, x) => acc + x, 0);
      """#
  }
  notes #"""
    Press the right arrow slowly and watch `total`, `items` and `return` keep their identity.
    """#
}

slide layout="code-side" {
  heading "Several code blocks on one slide"
  text "Blocks without an `#id` are independent: each is its own animation, side by side or one below the other."
  code "typescript" #"""
    const a = 1;
    """#
  text "Text can sit between the blocks."
  code "python" #"""
    b = 2
    """#
  step {
    text "Blocks with the same `#id` are frames of one block. The second click morphs it:"
  }
  step {
    swap {
      code "typescript" #"""
        function f() { return 1; }
        """#
      code "typescript" #"""
        function f() { return 2; }
        """#
    }
  }
}

slide {
  title "What the diff does"
  text "Six kinds of edit, one at a time. Each one is a child of a `swap` under this title and slides in from the left: press → to play it, → again for the next."
  swap anim=left {
    col {
      heading "`rename`"
      text "Only the identifiers change; every other token stays exactly where it is."
      swap autoplay=1 loop {
        code "typescript" #"""
          function area(r: number) {
            return Math.PI * r * r;
          }
          """#
        code "typescript" #"""
          function circleArea(radius: number) {
            return Math.PI * radius * radius;
          }
          """#
      }
    }
    col {
      heading "`insert`"
      text "New lines fade in; the lines below glide down to make room."
      swap autoplay=1 loop {
        code "typescript" #"""
          function greet(name: string) {
            return "Hello, " + name;
          }
          """#
        code "typescript" #"""
          function greet(name: string) {
            if (!name) {
              throw new Error("name required");
            }
            return "Hello, " + name;
          }
          """#
      }
    }
    col {
      heading "`delete`"
      text "Removed lines fade out and the rest closes the gap. Going backwards turns deletion into insertion."
      swap autoplay=1 loop {
        code "typescript" #"""
          function connect(url: string) {
            console.log("connecting to", url);
            const socket = new WebSocket(url);
            console.log("socket created");
            return socket;
          }
          """#
        code "typescript" #"""
          function connect(url: string) {
            const socket = new WebSocket(url);
            return socket;
          }
          """#
      }
    }
    col {
      heading "`move`"
      text "Statements swap places; every token glides to its new position instead of disappearing and reappearing."
      swap autoplay=1 loop {
        code "typescript" #"""
          function init() {
            connect();
            loadConfig();
            start();
          }
          """#
        code "typescript" #"""
          function init() {
            loadConfig();
            connect();
            start();
          }
          """#
      }
    }
    col {
      heading "`wrap`"
      text "Wrapping code in a block re-indents it: the original tokens slide right and the wrapper fades in."
      swap autoplay=1 loop {
        code "typescript" #"""
          function save(data: Data) {
            write(data);
            log("saved");
          }
          """#
        code "typescript" #"""
          function save(data: Data) {
            try {
              write(data);
              log("saved");
            } catch (err) {
              report(err);
            }
          }
          """#
      }
    }
    col {
      heading "`extract`"
      text "The moved lines keep their identity inside the new function."
      swap autoplay=1 loop {
        code "typescript" #"""
          function report(order: Order) {
            const total = order.items.reduce((s, i) => s + i.price, 0);
            console.log(order.id, total);
          }
          """#
        code "typescript" #"""
          function sum(order: Order) {
            return order.items.reduce((s, i) => s + i.price, 0);
          }
    
          function report(order: Order) {
            const total = sum(order);
            console.log(order.id, total);
          }
          """#
      }
    }
  }
}

slide layout="code" {
  notes #"""
    Each edit changes exactly one token or a tiny region; everything else must stay still.
    """#
  heading "Small edits, one at a time"
  swap {
    code "typescript" id=g1 #"""
      if (count > 10) {
        alert("too many items: " + count);
      }
      """#
    code "typescript" #"""
      if (count >= 10) {
        alert("too many items: " + count);
      }
      """#
    code "typescript" #"""
      if (count >= limit) {
        alert("too many items: " + count);
      }
      """#
    code "typescript" #"""
      if (count >= limit) {
        alert(`too many items: ${count}`);
      }
      """#
    code "typescript" #"""
      if (count >= limit) {
        notify(`too many items: ${count}`);
      }
      """#
  }
}
slide layout="code" {
  heading "Reorder arguments"
  swap {
    code "typescript" id=g2 #"""
      const point = makePoint(y, x, label, color);
      """#
    code "typescript" #"""
      const point = makePoint(x, y, label, color);
      """#
    code "typescript" #"""
      const point = makePoint(x, y, color, label);
      """#
  }
}
slide layout="code" {
  heading "if / else to a ternary"
  swap {
    code "typescript" #"""
      let label;
      if (count === 1) {
        label = "item";
      } else {
        label = "items";
      }
      """#
    code "typescript" #"""
      const label = count === 1 ? "item" : "items";
      """#
  }
}
slide layout="code" {
  heading "Loop to method chain"
  swap {
    code "typescript" #"""
      const names = [];
      for (const user of users) {
        if (user.active) {
          names.push(user.name);
        }
      }
      """#
    code "typescript" #"""
      const names = users
        .filter((user) => user.active)
        .map((user) => user.name);
      """#
  }
}

slide layout="code-side" {
  heading "A longer story: growing a class"
  text "Eight frames, one idea each: a stack grows a size, a guard and a protocol. Walk through them slowly; this is how a real refactoring talk reads."
  swap {
    code "python" id=g1 #"""
      class Stack:
          pass
      """#
    code "python" #"""
      class Stack:
          def __init__(self):
              self.items = []
      """#
    code "python" #"""
      class Stack:
          def __init__(self):
              self.items = []

          def push(self, item):
              self.items.append(item)
      """#
    code "python" #"""
      class Stack:
          def __init__(self):
              self.items = []

          def push(self, item):
              self.items.append(item)

          def pop(self):
              return self.items.pop()
      """#
    code "python" #"""
      class Stack:
          def __init__(self):
              self.items = []

          def push(self, item):
              self.items.append(item)

          def pop(self):
              if not self.items:
                  raise IndexError("empty")
              return self.items.pop()
      """#
    code "python" #"""
      class Stack:
          def __init__(self):
              self._items = []

          def push(self, item):
              self._items.append(item)

          def pop(self):
              if not self._items:
                  raise IndexError("empty")
              return self._items.pop()
      """#
    code "python" #"""
      class Stack:
          def __init__(self):
              self._items = []

          def push(self, item):
              self._items.append(item)

          def pop(self):
              if not self._items:
                  raise IndexError("empty")
              return self._items.pop()

          def __len__(self):
              return len(self._items)
      """#
    code "python" #"""
      class Stack:
          def __init__(self):
              self._items = []

          def push(self, item):
              self._items.append(item)

          def pop(self):
              if not self:
                  raise IndexError("empty")
              return self._items.pop()

          def __len__(self):
              return len(self._items)
      """#
  }
}

slide {
  notes #"""
    Matching needs two trees of the same language. Between languages the old code fades out and the new one fades in.
    """#
  title "Across languages"
  text "The same function in three languages, one child of a `swap` each under the same title, sliding in from the left. The diff can't match different grammars, so moving from one to the next is a plain cross-fade."
  swap anim=left {
    col {
      heading "TypeScript"
      code "typescript" #"""
        function clamp(x: number, lo: number, hi: number) {
          return Math.min(Math.max(x, lo), hi);
        }
        """#
    }
    col {
      heading "Python"
      code "python" #"""
        def clamp(x, lo, hi):
            return min(max(x, lo), hi)
        """#
    }
    col {
      heading "Go"
      code "go" #"""
        func Clamp(x, lo, hi int) int {
        	return min(max(x, lo), hi)
        }
        """#
    }
  }
}

slide layout="code-side" {
  heading "Languages"
  text "Fence tags map to [tree-sitter](https://tree-sitter.github.io/) grammars, loaded lazily and only for the languages a deck uses. Every language animates the same way; here is Rust."
  list {
    - "**TypeScript / JavaScript:** `ts` `tsx` `js` `jsx`"
    - "**C family:** `c` `cpp` (`cc` `cxx` `hpp` `h`)"
    - "**JVM:** `java`"
    - "**Systems:** `rs` / `rust` · `go`"
    - "**Scripting:** `py` · `lua` · `sh` / `bash`"
    - "**Web & data:** `html` `css` `json`"
    - "anything else (`text`, `toml`, `yaml`, `markdown`, …) is a **static code block**; tabs become four spaces"
  }
  swap {
    code "rust" id=g1 #"""
      fn sum(xs: &[i32]) -> i32 {
          let mut total = 0;
          for x in xs {
              total += x;
          }
          total
      }
      """#
    code "rust" #"""
      fn sum(xs: &[i32]) -> i32 {
          xs.iter().sum()
      }
      """#
  }
  notes #"""
    Matching works across languages because it only sees a generic tree. New language: tags.json + main.ts.
    """#
}

slide layout="code-side" {
  heading "Code style: panel, line numbers, title"
  text "Per block: classes `.panel` (a background box), `.lines` (line numbers) and options `start=10`, `title=\"cart.ts\"`, `bg=#16213e`, `radius=14`, `pad=\"1em 1.4em\"`. Deck-wide defaults live under `code` in `deck.json`."
  code "typescript" lines title="cart.ts" start=10 #"""
    export function total(items: Item[]): number {
      let sum = 0;
      for (const item of items) sum += item.price;
      return sum;
    }
    """#
  code "typescript" bg="#fff1cf" title="no numbers, own color" #"""
    const rate = 0.23;
    """#
}

slide layout="code-side" {
  notes #"""
    Options are attributes of the tag: <code lang=ts class=left size=18>
    """#
  notes #"""
    Next: focus=, fit and size in detail.
    """#
  heading "Code options: alignment"
  text "Alignment: `align=` (`left` | `center` | `right`) and `valign=` (`top` | `middle` | `bottom`). Without them the code follows its slide: `start`, unless the slide says otherwise. Other options: `id` (the animation), classes `lines` and `panel`, `title=`, `size=`, `fit=none`, `focus=`, `transition=` (see the next slides), and `autoplay=1` with `loop`: the frames play by themselves, as on the diff slides."
  swap {
    code "typescript" id=g1 align=left #"""
      const where = "left";
      """#
    code "typescript" #"""
      const where = "still left, now longer";
      """#
  }
}
slide layout="code-side" {
  heading "Code options: size"
  text "`size=14` fixes the font size in pixels. Without it the code is scaled to fit, using the largest frame of the block, so the size never jumps between frames."
  swap {
    code "typescript" id=g2 size=14 #"""
      const small = "size=14";
      """#
    code "typescript" #"""
      const small = "size=14, and the same font size in every frame";
      """#
  }
}
slide layout="code" {
  heading "Code options: `class=\"right top\"`"
  code "typescript" align=right valign=top #"""
    const corner = "top right";
    """#
}

slide layout="code-side" {
  heading "Focus lines"
  text "`focus=2-4` keeps those lines bright and dims the rest. Set it **per frame** — here the code never changes, only the focus does, so the lines fade smoothly."
  swap {
    code "typescript" id=g1 focus=1 #"""
      function checkout(cart: Cart, user: User) {
        const total = price(cart);
        const discount = loyalty(user);
        const final = total - discount;
        charge(user, final);
        return receipt(cart, final);
      }
      """#
    code "typescript" focus=2 #"""
      function checkout(cart: Cart, user: User) {
        const total = price(cart);
        const discount = loyalty(user);
        const final = total - discount;
        charge(user, final);
        return receipt(cart, final);
      }
      """#
    code "typescript" focus="2-4" #"""
      function checkout(cart: Cart, user: User) {
        const total = price(cart);
        const discount = loyalty(user);
        const final = total - discount;
        charge(user, final);
        return receipt(cart, final);
      }
      """#
    code "typescript" focus="5-6" #"""
      function checkout(cart: Cart, user: User) {
        const total = price(cart);
        const discount = loyalty(user);
        const final = total - discount;
        charge(user, final);
        return receipt(cart, final);
      }
      """#
    code "typescript" focus=5 #"""
      function checkout(cart: Cart, user: User) {
        const total = price(cart);
        const discount = loyalty(user);
        const final = total - discount;
        await charge(user, final);
        return receipt(cart, final);
      }
      """#
    code "typescript" #"""
      function checkout(cart: Cart, user: User) {
        const total = price(cart);
        const discount = loyalty(user);
        const final = total - discount;
        await charge(user, final);
        return receipt(cart, final);
      }
      """#
  }
  notes #"""
    Syntax: focus="2-4,7" on a code of a swap  (1-based lines, ranges and comma lists). Great for "now look at this part".
    """#
}

slide layout="code-side" {
  notes #"""
    The largest frame of a block decides the scale, so the font size is constant across frames.
    """#
  heading "Fit: code scales to the available space"
  text "Code is scaled to fit the slide (between half and 1.6x). The **largest** frame of a block decides, so the first frame below looks small: the next one is 16 lines long. Press → and it stays the same size."
  swap {
    code "typescript" id=g1 #"""
      const a = 1;
      """#
    code "typescript" #"""
      const a = 1;
      const b = 2;
      const c = a + b;
      const d = c * 2;
      const e = d - a;
      const f = e / b;
      const g = f % 3;
      const h = g ** 2;
      const i = h + 1;
      const j = i + 2;
      const k = j + 3;
      const l = k + 4;
      const m = l + 5;
      const n = m + 6;
      const o = n + 7;
      const p = o + 8;
      """#
  }
}
slide layout="code-side" {
  heading "`size=` fixes the font size"
  text "Two frames, `size=30`: the code is big and stays big."
  swap {
    code "typescript" id=g2 size=30 #"""
      const big = "size=30";
      """#
    code "typescript" #"""
      const big = "size=30";
      const bigger = big + "!";
      """#
  }
}
slide layout="code-side" {
  heading "`fit=none`"
  text "No automatic scaling at all (scale 1). Use it with a fixed `size` when you control the content."
  code "typescript" fit=none #"""
    const plain = "scale 1, no fit";
    """#
}

slide {
  heading "Transitions: `transition=`"
  text "A `swap` changes its states with its `transition`; by default they **morph**:"
  list {
    - "`morph` (default): the diff animation"
    - "`fade`: no matching, the old code fades out, the new code fades in"
    - "`none`: a hard cut, no animation at all"
  }
  text "Three clicks, one swap each, in this order."
  row {
    col {
      heading size=3 "morph"
        swap transition=morph {
          code "typescript" #"""
            function area(w: number, h: number) {
              return w * h;
            }
            """#
          code "typescript" #"""
            function area(width: number, height: number) {
              return width * height;
            }
            """#
        }
    }
    col {
      heading size=3 "fade"
        swap transition=fade {
          code "typescript" #"""
            function area(w: number, h: number) {
              return w * h;
            }
            """#
          code "typescript" #"""
            function area(width: number, height: number) {
              return width * height * 2;
            }
            """#
        }
    }
    col {
      heading size=3 "none"
        swap transition=none {
          code "typescript" #"""
            function area(w: number, h: number) {
              return w * h;
            }
            """#
          code "typescript" #"""
            function area(width: number, height: number) {
              return width * height * 3;
            }
            """#
        }
    }
  }
  notes #"""
    transition is a property of the swap: morph, fade or none for code (and any transition of the deck for other things).
    """#
}

slide {
  heading "How the matching works"
  text "For every pair of consecutive frames of a code group:"
  list numbered {
    - "both are parsed into syntax trees, flattened to generic `{ label, text, children }` nodes"
    - "**top-down**: identical subtrees are matched, tallest first"
    - "**bottom-up**: containers are matched by how many matched descendants they share"
    - "**extra cues**: text of identifiers and literals, position in the file, the node's slot in its parent"
    - "a **leaf pass** rescues unique identifiers inside matched containers"
  }
  text "Matched tokens become the same DOM element, so a CSS transition moves them; unmatched old tokens fade out, unmatched new ones fade in."
  notes #"""
    Based on GumTree (Falleri et al., 2014). Details in README and src/gumtree.ts.
    """#
}

slide theme=midnight layout=cover align=center valign=middle justify=#false background="bg.svg" transition=zoom {
  title "That's all"
  text "More decks in this series: **Showcase**, **Writing slides**, **Theming and layout**, **Presenting and shipping**."
  text "Start your own: `slideit dev my-talk/`"
  notes #"""
    The end.
    """#
}
