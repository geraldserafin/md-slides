{
  "title": "Sourdough 101",
  "description": "A baking workshop: ingredients grid, a timeline diagram, steps that appear on click, a chart",
  "order": 8,
  "theme": "flour",
  "schemes": {
    "light": "flour",
    "dark": "crust"
  },
  "css": "deck.css",
  "themes": {
    "flour": {
      "--tok-keyword": "#a23b72",
      "--tok-ident": "#23262e",
      "--tok-property": "#2f6690",
      "--tok-type": "#8a6d1f",
      "--tok-builtin": "#b0572a",
      "--tok-comment": "#9a9ca5",
      "--tok-punct": "#8c8f99",
      "--tok-plain": "#3a3d46",
      "--bg": "#fbf5ec",
      "--fg": "#4a3b2c",
      "--heading": "#2a1d12",
      "--muted": "#9a8670",
      "--accent": "#b4561f",
      "--code-bg": "#f1e6d4"
    },
    "crust": {
      "--tok-keyword": "#e3a76f",
      "--tok-ident": "#e5e5e5",
      "--tok-property": "#86b4dc",
      "--tok-type": "#d6c28a",
      "--tok-builtin": "#c58fa8",
      "--tok-comment": "#6b6b6b",
      "--tok-punct": "#7a7a7a",
      "--tok-plain": "#c4c4c4",
      "--bg": "#2a1d14",
      "--fg": "#ead9c3",
      "--heading": "#fff3e0",
      "--muted": "#a38b72",
      "--accent": "#e9a15b",
      "--code-bg": "#211610"
    }
  },
  "animation": {
    "move": 0.5,
    "fade": 0.3,
    "textTransition": "fade"
  },
  "footer": {
    "left": "Sourdough 101 · workshop",
    "right": "{slide} / {slides}",
    "height": 48
  },
  "fonts": [
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    }
  ],
  "vars": {
    "--font-text": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "--font-heading": "\"Libertinus Serif\", Georgia, serif",
    "--text-size": "clamp(21px, 3.5vmin, 46px)",
    "--heading-size": "clamp(34px, 5.8vmin, 76px)"
  },
  "defaults": {
    "justify": "false",
    "padding": "9vmin 12vmin"
  }
}
