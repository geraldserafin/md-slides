{
  "title": "Northwind: Q3 review",
  "description": "A business review: highlights, line and bar charts, a metrics table, risks and decisions",
  "order": 6,
  "theme": "corporate",
  "schemes": {
    "light": "corporate",
    "dark": "corporate-dark"
  },
  "css": "deck.css",
  "themes": {
    "corporate": {
      "--tok-keyword": "#a23b72",
      "--tok-ident": "#23262e",
      "--tok-property": "#2f6690",
      "--tok-type": "#8a6d1f",
      "--tok-builtin": "#b0572a",
      "--tok-comment": "#9a9ca5",
      "--tok-punct": "#8c8f99",
      "--tok-plain": "#3a3d46",
      "--bg": "#ffffff",
      "--fg": "#273142",
      "--heading": "#0b1b3a",
      "--muted": "#6b7688",
      "--accent": "#2563eb",
      "--code-bg": "#eef2f8"
    },
    "corporate-dark": {
      "--tok-keyword": "#e3a76f",
      "--tok-ident": "#e5e5e5",
      "--tok-property": "#86b4dc",
      "--tok-type": "#d6c28a",
      "--tok-builtin": "#c58fa8",
      "--tok-comment": "#6b6b6b",
      "--tok-punct": "#7a7a7a",
      "--tok-plain": "#c4c4c4",
      "--bg": "#0f172a",
      "--fg": "#cbd5e1",
      "--heading": "#f8fafc",
      "--muted": "#7c8aa5",
      "--accent": "#60a5fa",
      "--code-bg": "#16213a"
    }
  },
  "animation": {
    "move": 0.5,
    "fade": 0.3,
    "textTransition": "fade"
  },
  "footer": {
    "left": "Northwind · Q3 review",
    "right": "{slide} / {slides}",
    "height": 48,
    "border": true
  },
  "fonts": [
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    },
    {
      "family": "Libertinus Serif",
      "src": "fonts/libertinus-serif-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-normal.woff2",
      "weight": "400",
      "style": "normal"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-400-italic.woff2",
      "weight": "400",
      "style": "italic"
    },
    {
      "family": "Source Sans 3",
      "src": "fonts/source-sans-3-latin-700-normal.woff2",
      "weight": "700",
      "style": "normal"
    }
  ],
  "vars": {
    "--font-text": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "--font-heading": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "--text-size": "clamp(18px, 2.55vmin, 33px)",
    "--heading-size": "clamp(26px, 4.1vmin, 52px)"
  },
  "defaults": {
    "justify": "false",
    "padding": "9vmin 12vmin"
  }
}
