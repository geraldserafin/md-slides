<slide>
  section-transition: slide-right
</slide>

<head>
  # What the diff does

  Six kinds of edit, one at a time. Each one is a section under this title and slides in from the left (`section-transition: slide-right`): press → to play it, → again for the next.
</head>

<section>
  ## `rename`

  Only the identifiers change; every other token stays exactly where it is.

  <code lang=typescript>
    <frame>
      function area(r: number) {
        return Math.PI * r * r;
      }
    </frame>
    <frame>
      function circleArea(radius: number) {
        return Math.PI * radius * radius;
      }
    </frame>
  </code>
</section>

<section>
  ## `insert`

  New lines fade in; the lines below glide down to make room.

  <code lang=typescript>
    <frame>
      function greet(name: string) {
        return "Hello, " + name;
      }
    </frame>
    <frame>
      function greet(name: string) {
        if (!name) {
          throw new Error("name required");
        }
        return "Hello, " + name;
      }
    </frame>
  </code>
</section>

<section>
  ## `delete`

  Removed lines fade out and the rest closes the gap. Going backwards turns deletion into insertion.

  <code lang=typescript>
    <frame>
      function connect(url: string) {
        console.log("connecting to", url);
        const socket = new WebSocket(url);
        console.log("socket created");
        return socket;
      }
    </frame>
    <frame>
      function connect(url: string) {
        const socket = new WebSocket(url);
        return socket;
      }
    </frame>
  </code>
</section>

<section>
  ## `move`

  Statements swap places; every token glides to its new position instead of disappearing and reappearing.

  <code lang=typescript>
    <frame>
      function init() {
        connect();
        loadConfig();
        start();
      }
    </frame>
    <frame>
      function init() {
        loadConfig();
        connect();
        start();
      }
    </frame>
  </code>
</section>

<section>
  ## `wrap`

  Wrapping code in a block re-indents it: the original tokens slide right and the wrapper fades in.

  <code lang=typescript>
    <frame>
      function save(data: Data) {
        write(data);
        log("saved");
      }
    </frame>
    <frame>
      function save(data: Data) {
        try {
          write(data);
          log("saved");
        } catch (err) {
          report(err);
        }
      }
    </frame>
  </code>
</section>

<section>
  ## `extract`

  The moved lines keep their identity inside the new function.

  <code lang=typescript>
    <frame>
      function report(order: Order) {
        const total = order.items.reduce((s, i) => s + i.price, 0);
        console.log(order.id, total);
      }
    </frame>
    <frame>
      function sum(order: Order) {
        return order.items.reduce((s, i) => s + i.price, 0);
      }

      function report(order: Order) {
        const total = sum(order);
        console.log(order.id, total);
      }
    </frame>
  </code>
</section>
