slide layout=cover align=center valign=middle justify=#false {
  title "Code in motion"
  text "Write plain tags and text. Press →. Every edit to the code is animated."
  text "A two-minute tour of what this tool does · press **→**"
  notes #"""
    Showcase: part of the slides manual. Source: examples/showcase.
    """#
}

slide {
  col {
    heading "Code that moves"
    text "Write the *before* and the *after* as two code blocks. `slides` parses both, matches the syntax trees and animates the difference: unchanged tokens stay, moved tokens glide, new ones fade in."
    swap {
      code "typescript" id=g1 #"""
        function total(items: number[]) {
          let sum = 0;
          for (const x of items) {
            sum += x;
          }
          return sum;
        }
        """#
      code "typescript" #"""
        function total(items: number[]) {
          const sum = items.reduce(
            (acc, x) => acc + x,
            0,
          );
          return sum;
        }
        """#
      code "typescript" #"""
        const total = (items: number[]) =>
          items.reduce((acc, x) => acc + x, 0);
        """#
    }
  }
  notes #"""
    Press the right arrow slowly and watch `total`, `items` and `return` keep their identity.
    """#
}

slide {
  heading "What the diff does"
  text "Six kinds of edit, one at a time. Each one is a child of a `swap` under this title and slides in from the left: press → to play it, → again for the next."
  swap anim=right {
    col {
      text "`rename` - Only the identifiers change; every other token stays exactly where it is."
      swap autoplay=1 loop {
        code "typescript" #"""
          function area(r: number) {
            return Math.PI * r * r;
          }
          """#
        code "typescript" #"""
          function circleArea(radius: number) {
            return Math.PI * radius * radius;
          }
          """#
      }
    }
    col {
      heading "`insert`"
      text "New lines fade in; the lines below glide down to make room."
      swap autoplay=1 loop {
        code "typescript" #"""
          function greet(name: string) {
            return "Hello, " + name;
          }
          """#
        code "typescript" #"""
          function greet(name: string) {
            if (!name) {
              throw new Error("name required");
            }
            return "Hello, " + name;
          }
          """#
      }
    }
    col {
      heading "`delete`"
      text "Removed lines fade out and the rest closes the gap. Going backwards turns deletion into insertion."
      swap autoplay=1 loop {
        code "typescript" #"""
          function connect(url: string) {
            console.log("connecting to", url);
            const socket = new WebSocket(url);
            console.log("socket created");
            return socket;
          }
          """#
        code "typescript" #"""
          function connect(url: string) {
            const socket = new WebSocket(url);
            return socket;
          }
          """#
      }
    }
    col {
      heading "`move`"
      text "Statements swap places; every token glides to its new position instead of disappearing and reappearing."
      swap autoplay=1 loop {
        code "typescript" #"""
          function init() {
            connect();
            loadConfig();
            start();
          }
          """#
        code "typescript" #"""
          function init() {
            loadConfig();
            connect();
            start();
          }
          """#
      }
    }
    col {
      heading "`wrap`"
      text "Wrapping code in a block re-indents it: the original tokens slide right and the wrapper fades in."
      swap autoplay=1 loop {
        code "typescript" #"""
          function save(data: Data) {
            write(data);
            log("saved");
          }
          """#
        code "typescript" #"""
          function save(data: Data) {
            try {
              write(data);
              log("saved");
            } catch (err) {
              report(err);
            }
          }
          """#
      }
    }
    col {
      heading "`extract`"
      text "The moved lines keep their identity inside the new function."
      swap autoplay=1 loop {
        code "typescript" #"""
          function report(order: Order) {
            const total = order.items.reduce((s, i) => s + i.price, 0);
            console.log(order.id, total);
          }
          """#
        code "typescript" #"""
          function sum(order: Order) {
            return order.items.reduce((s, i) => s + i.price, 0);
          }
    
          function report(order: Order) {
            const total = sum(order);
            console.log(order.id, total);
          }
          """#
      }
    }
  }
}

slide {
  col {
  heading "A longer story: growing a class"
  text "Eight frames, one idea each: a stack grows a size, a guard and a protocol. Walk through them slowly; this is how a real refactoring talk reads."
  swap {
    code "python" id=g1 #"""
      class Stack:
          pass
      """#

    code "python" #"""
      class Stack:
          def __init__(self):
              self.items = []
      """#

    code "python" #"""
      class Stack:
          def __init__(self):
              self.items = []

          def push(self, item):
              self.items.append(item)
      """#

    code "python" #"""
      class Stack:
          def __init__(self):
              self.items = []

          def push(self, item):
              self.items.append(item)

          def pop(self):
              return self.items.pop()
      """#

    code "python" #"""
      class Stack:
          def __init__(self):
              self.items = []

          def push(self, item):
              self.items.append(item)

          def pop(self):
              if not self.items:
                  raise IndexError("empty")
              return self.items.pop()
      """#

    code "python" #"""
      class Stack:
          def __init__(self):
              self._items = []

          def push(self, item):
              self._items.append(item)

          def pop(self):
              if not self._items:
                  raise IndexError("empty")
              return self._items.pop()
      """#

    code "python" #"""
      class Stack:
          def __init__(self):
              self._items = []

          def push(self, item):
              self._items.append(item)

          def pop(self):
              if not self._items:
                  raise IndexError("empty")
              return self._items.pop()

          def __len__(self):
              return len(self._items)
      """#

    code "python" #"""
      class Stack:
          def __init__(self):
              self._items = []

          def push(self, item):
              self._items.append(item)

          def pop(self):
              if not self:
                  raise IndexError("empty")
              return self._items.pop()

          def __len__(self):
              return len(self._items)
      """#
  }
  }
}

slide {
  heading "Math"
  text "Inline math sits in the text: Euler's identity is $e^{i\\pi} + 1 = 0$, and a \\$5 price stays a price. Display math goes between double dollars and follows the slide's alignment:"
  math #"""
    \int_{-\infty}^{\infty} e^{-x^2}\,dx = \sqrt{\pi}
    \qquad
    \sum_{k=1}^{n} k = \frac{n(n+1)}{2}
    """#
  text "Math reveals like any other item: put it in a `step`."
  notes #"""
    KaTeX renders math to plain HTML (no scripts at runtime), so it works in every build target and in the PDF.
    """#
}

slide {
  heading "Charts"
  text "A `chart` node turns a few CSV lines into a chart in the slide's colors: `\"bar\"`, `\"line\"` or `\"pie\"`."
  chart "bar" title="Build time (s)" width="85%" #"""
    tool, cold, warm
    webpack, 12, 4
    vite, 3, 1.2
    esbuild, 1.5, 0.6
    """#
  notes #"""
    The first row names the series; with one series the bars carry their value. Charts are plain SVG, so they print and export like the rest. Reveal them with a `step`.
    """#
}

slide {
  heading "Diagrams"
  text "A `diagram` node draws a diagram with the slide's colors; press **t** to see it follow the theme."
  diagram width="100%" #"""
    flowchart LR
      md[.slides] --> parse[Parse] --> diff{{GumTree diff}} --> play[Animate]
      diff -. same language .-> play
      parse --> pdf[PDF / static / exe]
    """#
  notes #"""
    Mermaid is loaded when a slide first needs it and left out of builds whose decks never use it.
    """#
}

slide {
  col {
  heading "Morph anything"
  text "Not only code: an image, a heading or a diagram with the same `id` on the next slide glides from where it was. Images with the same file do it on their own. Press → to see it move."
  image "diagram.svg" align=left width="230px"
  }
  notes #"""
    Morph pairs items by id between two slides. Text that changes cross-fades while it moves.
    """#
}
slide layout="image-right" {
  heading "Same picture, bigger"
  image "diagram.svg" align=right width="460px"
  text "The picture above is the same file, so it grew and moved by itself. Give a heading or a paragraph the same `id` and it glides too."
}

slide {
  heading "Themes"
  text "Built in: `dark`, `light`, `paper`. Press **t** to cycle, or open `?theme=light`. Your own theme is a set of CSS variables in `deck.json` and joins the cycle:"
  code "jsonc" #"""
    "theme": "ocean",
    "themes": {
      "ocean": {
        "--bg": "#0b1d2a", "--fg": "#b8d4e3", "--heading": "#fff", "--accent": "#3ddc97",
        "--tok-keyword": "#ff7eb6", "--tok-ident": "#e6f4fb", "--tok-type": "#ffd479"
      }
    }
    """#
  notes #"""
    Token colors: --tok-keyword --tok-ident --tok-property --tok-type --tok-builtin --tok-comment --tok-punct --tok-plain. See this deck's own deck.json for two full themes (sunset, terminal).
    """#
}

slide theme=midnight layout=cover align=center valign=middle justify=#false background="bg.svg" transition=zoom {
  title "That's all"
  text "More decks in this series: **Writing slides**, **Code animation**, **Theming and layout**, **Presenting and shipping**."
  text "Start your own: `slideit dev my-talk/`"
  notes #"""
    The end.
    """#
}
