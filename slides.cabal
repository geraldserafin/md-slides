cabal-version:      3.0
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'slides' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               slides

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
-- synopsis:

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            BSD-3-Clause

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             geraldserafin

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         serafingerald@protonmail.com

-- A copyright notice.
-- copyright:
category:           Utility
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

-- Zwendorowane gramatyki tree-sitter (C sources). Każdy executable co
-- importuje 'Parse' (ma foreign import na OBIE gramatyki bezwarunkowo)
-- musi je linkować, inaczej "undefined reference" -- stąd common stanza,
-- nie duplikacja w każdym executable.
common tree-sitter-grammars
    c-sources:        cbits/typescript/parser.c
                      cbits/typescript/scanner.c
                      cbits/cpp/parser.c
                      cbits/cpp/scanner.c
    include-dirs:     cbits/typescript
                      cbits/cpp
    cc-options:       -std=c11

executable slides
    -- Import common warning flags.
    import:           warnings, tree-sitter-grammars

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    other-modules:    GumTree, Parse

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base ^>=4.20.2.0, hs-tree-sitter,  hashable ^>=1.5.1.0, bytestring, transformers, containers, text

    -- Directories containing source files.
    hs-source-dirs:   exe

    -- Base language which the package is written in.
    default-language: Haskell2010

-- Prototyp: okno (przeglądarka sterowana z Haskella), animacja przejść
-- między stanami kodu przez View Transitions API.
executable viewer
    import:           warnings, tree-sitter-grammars
    main-is:          Viewer.hs
    other-modules:    GumTree, Parse
    build-depends:    base ^>=4.20.2.0, hs-tree-sitter, hashable ^>=1.5.1.0, bytestring,
                      transformers, containers, threepenny-gui, text
    hs-source-dirs:   exe
    default-language: Haskell2010

-- Natywna, cross-platform (SDL2) apka slideshow -- finalny target projektu.
-- 'viewer' (threepenny/browser) zostaje jako dowód że sam mechanizm diffu
-- działa, ale to ta egzekutywa jest tym co faktycznie się rozwija.
executable sdl-viewer
    import:           warnings, tree-sitter-grammars
    main-is:          SdlViewer.hs
    other-modules:    GumTree, Parse, Layout, SlideDoc, Presenter
    build-depends:    base ^>=4.20.2.0, hs-tree-sitter, hashable ^>=1.5.1.0, bytestring,
                      containers, transformers, sdl2, sdl2-ttf, sdl2-image, text,
                      pandoc, directory, filepath, brick, vty, vty-crossplatform
    hs-source-dirs:   exe
    -- -threaded: TUI (brick/vty, blokujące IO na terminalu) i SDL (główny
    -- wątek) żyją w osobnych wątkach OS naraz -- bez tego RTS mógłby
    -- zablokować jeden drugim.
    ghc-options:      -threaded
    default-language: Haskell2010

-- Testy regresyjne diffu: test/fixtures/<nazwa>/{old,new}.<ext> + expect.txt
test-suite match-regression
    import:           warnings, tree-sitter-grammars
    type:             exitcode-stdio-1.0
    main-is:          MatchRegression.hs
    other-modules:    GumTree, Parse
    build-depends:    base ^>=4.20.2.0, hs-tree-sitter, hashable ^>=1.5.1.0, bytestring,
                      containers, transformers, text, directory, filepath
    hs-source-dirs:   test, exe
    default-language: Haskell2010
